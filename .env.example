# Copy this file to .env.local and add keys only for providers you intend to test.
# Local .env files are ignored by Git. Cathulu reads only these named variables.
# Keys alone do not enable a provider or permit remote data transmission; each
# run must explicitly enable a capability in shadow mode with remote consent.
CATHULU_DECISION_PROVIDER_API_KEY=
CATHULU_CONTEXT_PROVIDER_API_KEY=
