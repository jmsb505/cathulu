{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cathulu",
  "version": "0.1.0",
  "identifier": "app.cathulu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cathulu",
        "width": 820,
        "height": 760,
        "minWidth": 560,
        "minHeight": 540,
        "center": true,
        "focus": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"]
  }
}
